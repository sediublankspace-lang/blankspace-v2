---
// CourseModals — rendered in initial DOM for SEO.
// Each modal is hidden via aria-hidden + display logic controlled by JS.
// Content is available to crawlers on first parse.
---

<!-- ===================================================
     COURSE MODALS — pre-rendered HTML for SEO
     Visibility controlled by JS (no JS = no modal, content still present)
     =================================================== -->

<div id="course-modals-root" aria-live="polite">

  <!-- ── Modal: Design Interior ── -->

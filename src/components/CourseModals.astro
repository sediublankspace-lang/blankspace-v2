  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .modal-overlay { padding: 0.375rem; align-items: flex-end; }
    .modal-panel {
      max-height: calc(100svh - 0.375rem);
      border-radius: 1.25rem 1.25rem 0 0;
      max-width: 100%;
    }
    .modal-header { padding: 1.125rem 1rem 0.875rem; }
    .modal-body { padding: 1rem 1rem 2rem; gap: 1.25rem; }
    .modal-title { font-size: 1.0625rem; }
    .skill-cards { grid-template-columns: 1fr; }
    .modal-actions { flex-direction: column; }
    .modal-btn-primary, .modal-btn-secondary { flex: none; width: 100%; }
    .quick-info-item { min-width: calc(50% - 0.3125rem); }
  }
</style>

<script>
  // ── Modal controller ──
  (function () {
    const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';

    function openModal(id: string) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.style.display = 'flex';
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        const panel = overlay.querySelector<HTMLElement>('.modal-panel');
        if (panel) { panel.scrollTop = 0; panel.focus(); }
      });
    }

    function closeModal(id: string) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.style.display = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      const trigger = document.querySelector<HTMLElement>(`[data-open-modal="${id}"]`);
      if (trigger) trigger.focus();
    }

    function scrollToContact(interest?: string) {
      const contact = document.getElementById('contact');
      if (contact) contact.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (interest) {
        setTimeout(() => {
          const sel = document.getElementById('contact-interest') as HTMLSelectElement | null;
          if (sel) {
            sel.value = interest;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
          }
          // Move focus to first field
          const nameField = document.getElementById('contact-name') as HTMLElement | null;
          if (nameField) nameField.focus();
        }, 650);
      }
    }

    // Open triggers
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-open-modal]');
      if (target) { e.preventDefault(); openModal(target.dataset.openModal!); }
    });

    // In-modal anchor smooth scroll
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!anchor) return;
      const targetId = anchor.getAttribute('href');
      if (!targetId || targetId === '#') return;
      const targetEl = document.querySelector(targetId);
      if (targetEl && targetEl.closest('.modal-overlay[aria-hidden="false"]')) {
        e.preventDefault();
        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Close + Contact triggers
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-close-modal]');
      if (!target) return;
      const id = target.dataset.closeModal!;
      const interest = target.dataset.modalContact;
      closeModal(id);
      if (interest !== undefined) {
        scrollToContact(interest);
      }
    });

    // Escape
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector<HTMLElement>('.modal-overlay[aria-hidden="false"]');
      if (open) closeModal(open.id);
    });

    // Focus trap
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const open = document.querySelector<HTMLElement>('.modal-overlay[aria-hidden="false"]');
      if (!open) return;
      const focusables = Array.from(open.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
  })();
</script>

<style>
  /* ── Overlay ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 17, 0.68);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  /* ── Panel ── */
  .modal-panel {
    position: relative;
    z-index: 1;
    background: #FFFFFF;
    border-radius: 1.25rem;
    width: 100%;
    max-width: 640px;
    max-height: calc(100svh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 32px 80px rgba(0,0,0,0.22);
    border: 1px solid #D9D6D1;
    outline: none;
  }

  /* ── Header ── */
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem 1rem;
    border-bottom: 1px solid #EEEBE6;
    position: sticky;
    top: 0;
    background: #FFFFFF;
    z-index: 2;
  }
  .modal-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111111;
    line-height: 1.25;
    margin: 0;
  }
  .modal-close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    border-radius: 0.5rem;
    border: 1px solid #D9D6D1;
    background: transparent;
    color: #5A5A5A;
    cursor: pointer;
    transition: all 0.15s;
    padding: 0;
  }
  .modal-close:hover {
    background: #F4F4F4;
    color: #111111;
    border-color: #B8A22A;
  }
  .modal-close:focus-visible {
    outline: 2px solid #B8A22A;
    outline-offset: 2px;
  }

  /* ── Body ── */
  .modal-body {
    padding: 1.5rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .modal-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: 'Plus Jakarta Sans', sans-serif;
    letter-spacing: 0.04em;
    background: rgba(184,162,42,0.09);
    color: #8A7020;
    border: 1px solid rgba(184,162,42,0.22);
  }

  /* ── Section ── */
  .modal-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .modal-section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: #B8A22A;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .modal-section p {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: #374151;
    line-height: 1.65;
    margin: 0;
  }
  .modal-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .modal-list li {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: #374151;
    line-height: 1.5;
  }

  /* ── CTA ── */
  .modal-contact {
    padding-top: 0.5rem;
    border-top: 1px solid #EEEBE6;
  }
  .modal-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 0.625rem;
    padding: 0 1.75rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    background: #B8A22A;
    color: #111111;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 16px rgba(184,162,42,0.28);
    width: 100%;
    cursor: pointer;
  }
  .modal-cta:hover {
    transform: scale(1.01);
    box-shadow: 0 6px 22px rgba(184,162,42,0.38);
  }
  .modal-cta:focus-visible {
    outline: 2px solid #B8A22A;
    outline-offset: 3px;
  }

  /* ── Mobile adjustments ── */
  @media (max-width: 640px) {
    .modal-overlay {
      padding: 0.5rem;
      align-items: flex-end;
    }
    .modal-panel {
      max-height: calc(100svh - 0.5rem);
      border-radius: 1.25rem 1.25rem 0 0;
      max-width: 100%;
    }
    .modal-header {
      padding: 1.25rem 1.25rem 0.875rem;
    }
    .modal-body {
      padding: 1.25rem 1.25rem 2rem;
    }
    .modal-title {
      font-size: 1.0625rem;
    }
  }
</style>

<script>
  // ── Modal controller — no dependencies ──
  (function () {
    const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';

    function openModal(id: string) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.style.display = 'flex';
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Focus first focusable
      requestAnimationFrame(() => {
        const first = overlay.querySelector<HTMLElement>(FOCUSABLE);
        if (first) first.focus();
      });
    }

    function closeModal(id: string) {
      const overlay = document.getElementById(id);
      if (!overlay) return;
      overlay.style.display = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Return focus to trigger
      const trigger = document.querySelector<HTMLElement>(`[data-open-modal="${id}"]`);
      if (trigger) trigger.focus();
    }

    // Open triggers
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-open-modal]');
      if (target) {
        e.preventDefault();
        openModal(target.dataset.openModal!);
      }
    });

    // Close triggers (backdrop + X button)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-close-modal]');
      if (target) {
        const id = target.dataset.closeModal!;
        // If it's the CTA link, navigate first then close
        if (target.tagName === 'A') {
          const interest = target.dataset.interest;
          if (interest) {
            // Pre-select interest in contact form
            const select = document.getElementById('contact-interest') as HTMLSelectElement;
            if (select) {
              select.value = interest;
              // Trigger change event for any listeners
              select.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
          closeModal(id);
          // Navigation happens naturally via the href
          return;
        }
        closeModal(id);
      }
    });

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector<HTMLElement>('.modal-overlay[aria-hidden="false"]');
      if (open) closeModal(open.id);
    });

    // Focus trap
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const open = document.querySelector<HTMLElement>('.modal-overlay[aria-hidden="false"]');
      if (!open) return;
      const focusables = Array.from(open.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

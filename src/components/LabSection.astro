---
const capabilities = [
  {
    title: "Scanare 3D obiecte",
    desc: "Scanare 3D obiecte – digitalizarea obiectelor fizice pentru reproducere, adaptare, măsurare sau dezvoltarea unor modele 3D.",
    icon: `<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 003.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0120.25 6v1.5m0 9V18A2.25 2.25 0 0118 20.25h-1.5m-9 0H6A2.25 2.25 0 013.75 18v-1.5M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  },
  {
    title: "Modelare 3D",
    desc: "Design de produs și modelare parametrică pentru piese, obiecte și prototipuri personalizate.",
    icon: `<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>`
  },
  {
    title: "Imprimare 3D",
    desc: "Producție FDM și SLA cu filamente tehnice și materiale speciale pentru detalii de precizie.",
    icon: `<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" /></svg>`
  },
  {
    title: "Prototipare",
    desc: "De la concept la prototip funcțional, rapid și iterativ, cu feedback direct în procesul de lucru.",
    icon: `<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122l9.37-9.37m0 0l-1.01-1.01a2.25 2.25 0 00-3.182 0l-10.01 10.01a2.25 2.25 0 00-.596 1.006l-.73 2.922a.75.75 0 00.916.916l2.922-.73a2.25 2.25 0 001.006-.596l10.01-10.01a2.25 2.25 0 000-3.182l-1.01-1.01" /></svg>`
  },
];
---

<section id="studio" class="relative py-20 md:py-28 overflow-hidden" style="background: #111111;" aria-labelledby="studio-heading">

  {/* Subtle diagonal texture */}
  <div class="lab-grain absolute inset-0 -z-10 opacity-[0.02]"></div>

  {/* Ambient golden glow — center */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 w-[500px] h-[500px] rounded-full blur-[120px] pointer-events-none opacity-[0.07]"
       style="background: #B8A22A;"></div>

  {/* Ambient green glow — left edge */}
  <div class="absolute bottom-0 left-0 -z-10 w-[250px] h-[250px] rounded-full blur-[80px] pointer-events-none opacity-[0.05]"
       style="background: #6D7E53;"></div>

  <div class="mx-auto max-w-4xl px-6">

    {/* Section header — centered */}
    <div class="text-center mb-12 space-y-4">
      <div class="flex items-center justify-center gap-3">
        <span class="inline-block w-8 h-[2px]" style="background: #B8A22A;"></span>
        <span class="text-xs font-semibold tracking-[0.15em] uppercase" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">
          STUDIO 3D
        </span>
        <span class="inline-block w-8 h-[2px]" style="background: #B8A22A;"></span>
      </div>
      <h2 id="studio-heading" class="heading-2 text-center" style="color: #F4F4F4;">
        STUDIO 3D
      </h2>
      <p class="text-base leading-relaxed body-text max-w-2xl mx-auto text-center" style="color: #8A8A8A;">
        Transformăm ideile în obiecte și soluții personalizate. Lucrăm la proiecte custom folosind scanare 3D (obiecte fizice), modelare, imprimare 3D și prototipare pentru Brașov și împrejurimi.
      </p>
    </div>

    {/* Capabilities grid — 2×2 centered */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {capabilities.map(cap => (
        <div class="lab-card rounded-xl p-5 space-y-2.5 transition-all duration-300 cursor-default"
             style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);"
             onmouseover="this.style.borderColor='rgba(184,162,42,0.28)'; this.style.background='rgba(184,162,42,0.04)';"
             onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'; this.style.background='rgba(255,255,255,0.03)';">
          <div class="size-9 rounded-lg flex items-center justify-center"
               style="background: rgba(184,162,42,0.1); color: #B8A22A;"
               set:html={cap.icon}>
          </div>
          <h4 class="heading-4 font-semibold" style="color: #F4F4F4;">{cap.title}</h4>
          <p class="text-xs leading-normal body-text" style="color: #6A6A6A;">{cap.desc}</p>
        </div>
      ))}
    </div>

    {/* CTA */}
    <div class="text-center pt-8">
      <button
        type="button"
        id="studio-cta-btn"
        class="inline-flex min-h-[44px] h-11 items-center justify-center rounded-lg px-6 text-sm font-semibold transition-all hover:scale-[1.02] active:scale-[0.98] btn-text focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B8A22A] focus-visible:ring-offset-2 cursor-pointer"
        style="background: #B8A22A; color: #111111; box-shadow: 0 4px 20px rgba(184,162,42,0.28); border: none;"
        onclick="(function(){
          var contact = document.getElementById('contact');
          if(contact) contact.scrollIntoView({behavior:'smooth', block:'start'});
          setTimeout(function(){
            var sel = document.getElementById('contact-interest');
            if(sel){ sel.value='Studio 3D'; sel.dispatchEvent(new Event('change',{bubbles:true})); }
          }, 600);
        })()"
        aria-label="Solicită detalii despre Studio 3D BlankSpace"
      >
        Solicită detalii
      </button>
    </div>

  </div>
</section>

<style>
  .lab-grain {
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='40' height='40'%3E%3Cg fill='%23fff' fill-opacity='1'%3E%3Ccircle cx='0' cy='0' r='1'/%3E%3Ccircle cx='20' cy='20' r='1'/%3E%3C/g%3E%3C/svg%3E");
    background-repeat: repeat;
  }
</style>

---
const activities = [
  {
    id: "design-interior",
    modalId: "modal-design-interior",
    title: "Curs Design Interior",
    tagline: "curs design interior Brașov",
    badge: "Curs autorizat · program de specializare",
    desc: "Învață să analizezi spații, să elaborezi planuri de amenajare și să prezinți proiecte de design interior cu instrumente profesionale.",
    chips: null,
    icon: `<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>`
  },
  {
    id: "imprimare-3d",
    modalId: "modal-imprimare-3d",
    title: "Curs Imprimare 3D",
    tagline: "curs imprimare 3D Brașov",
    badge: null,
    desc: "Un curs practic pentru pasionați, începători și cei care vor să descopere imprimarea 3D, de la pregătirea modelului până la realizarea obiectului fizic. Posibilitate de certificare ICDL 3D Printing.",
    chips: null,
    icon: `<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>`
  },
  {
    id: "icdl",
    modalId: "modal-icdl",
    title: "Cursuri de competențe digitale ICDL",
    tagline: "cursuri ICDL Brașov competențe digitale",
    badge: null,
    desc: "Dezvoltă competențe digitale practice pentru școală, studiu și activitatea profesională, cu posibilitatea certificării internaționale ICDL.",
    chips: ["Documente / Word", "Calcul tabelar / Excel", "Prezentări / PowerPoint", "Utilizare Calculator & Navigare Online", "2D Design / CAD"],
    chipsSecondary: "Certificări și profile: ICDL CORE \u00b7 PROFIL BAC \u00b7 PROFIL DIDACTIC \u00b7 Alte module",
    icon: `<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>`
  },
  {
    id: "arhitectura",
    modalId: "modal-arhitectura",
    title: "Pregătire admitere Arhitectură",
    tagline: "pregătire admitere arhitectură Brașov curs desen arhitectură",
    badge: null,
    desc: "Pregătire practică pentru liceeni și viitori candidați la facultățile de arhitectură, cu exerciții de desen, perspectivă, compoziție, volumetrie și geometrie, dezvoltarea gândirii spațiale și pregătirea portofoliului.",
    chips: null,
    icon: `<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>`
  }
];
---

<section id="activitati" class="relative py-14 md:py-20" style="background: #FFFFFF; border-top: 1px solid #D9D6D1;" aria-labelledby="activitati-heading">
  <div class="mx-auto max-w-7xl px-6">

    {/* Section header */}
    <div class="max-w-4xl mb-14 md:mb-16">
      <div class="flex items-center gap-3 mb-5">
        <span class="inline-block w-8 h-[2px]" style="background: #B8A22A;"></span>
        <span class="text-xs font-semibold tracking-[0.15em] uppercase" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">
          Ce poți studia
        </span>
      </div>
      <h2 id="activitati-heading" class="heading-2" style="color: #111111;">
        Activitățile noastre principale
      </h2>
      <p class="mt-4 text-base leading-relaxed body-text" style="color: #4B5563;">
        Cursuri practice, certificări recunoscute și experiențe de învățare aplicate — pentru copii, adulți și organizații.
      </p>
    </div>

    {/* Cards grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {activities.map((act) => (
        <div
          id={`activity-card-${act.id}`}
          class="activity-card group relative flex flex-col justify-between rounded-2xl p-7 transition-all duration-300"
          style="background: #F4F4F4; border: 1px solid #D9D6D1;"
          onmouseover="this.style.borderColor='rgba(184,162,42,0.45)'; this.style.boxShadow='0 12px 40px rgba(0,0,0,0.07)'; this.style.background='#FFFFFF';"
          onmouseout="this.style.borderColor='#D9D6D1'; this.style.boxShadow='none'; this.style.background='#F4F4F4';"
        >
          {/* Top accent line on hover */}
          <div class="absolute top-0 left-0 right-0 h-[2px] rounded-t-2xl w-0 group-hover:w-full transition-all duration-500"
               style="background: #B8A22A;"></div>

          <div>
            {/* Icon container */}
            <div class="size-12 rounded-xl flex items-center justify-center mb-5 transition-all duration-300"
                 style="background: rgba(184,162,42,0.07); border: 1px solid rgba(184,162,42,0.18); color: #B8A22A;"
                 set:html={act.icon}>
            </div>

            {/* Optional badge */}
            {act.badge && (
              <span class="inline-block mb-3 px-2.5 py-1 rounded-md text-[11px] font-semibold tracking-wide"
                    style="background: rgba(184,162,42,0.09); color: #8A7020; border: 1px solid rgba(184,162,42,0.2); font-family: 'Plus Jakarta Sans', sans-serif;">
                {act.badge}
              </span>
            )}

            <h3 class="heading-3 mb-2 transition-colors duration-200 group-hover:text-[#B8A22A]" style="color: #111111;">
              {act.title}
            </h3>

            {/* Hidden SEO tagline */}
            <p class="sr-only">{act.tagline}</p>

            <p class="text-sm leading-relaxed body-text" style="color: #4B5563;">
              {act.desc}
            </p>

            {/* Optional module chips */}
            {act.chips && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {act.chips.map((chip: string) => (
                  <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-medium"
                        style="background: #F0EDE8; color: #5A5A5A; border: 1px solid #D9D6D1; font-family: 'Inter', sans-serif;">
                    {chip}
                  </span>
                ))}
              </div>
            )}

            {/* Secondary chips line — certifications/profiles */}
            {act.chipsSecondary && (
              <p class="mt-2 text-[11px] leading-snug" style="color: #8A8A8A; font-family: 'Inter', sans-serif; font-style: italic;">
                {act.chipsSecondary}
              </p>
            )}
          </div>

          {/* CTA — triggers modal */}
          <div class="flex items-center gap-1.5 text-sm font-semibold mt-6 pt-5 transition-all duration-200"
               style="border-top: 1px solid #D9D6D1;">
            <button
              type="button"
              class="inline-flex items-center gap-1.5 min-h-[44px] transition-colors duration-200 btn-text focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B8A22A] focus-visible:ring-offset-2 rounded cursor-pointer"
              style="color: #B8A22A; font-size: 0.875rem; background: none; border: none; padding: 0; font-family: inherit;"
              data-open-modal={act.modalId}
              aria-label={`Vezi detalii — ${act.title}`}
              aria-haspopup="dialog"
            >
              Vezi detalii
              <svg class="size-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </div>
        </div>
      ))}

    </div><!-- /grid -->
  </div><!-- /max-w-7xl -->
</section>

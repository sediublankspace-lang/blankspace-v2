---
const projects = [
  {
    title: "Obiect de Design Interior",
    category: "Design",
    desc: "Piesă de mobilier decorativă proiectată și realizată în Studio, combinând estetica minimalistă cu materialele naturale.",
    image: "https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?auto=format&fit=crop&w=600&q=80",
    alt: "Proiect de design interior realizat la BlankSpace Studio Brașov"
  },
  {
    title: "Prototip Custom 3D",
    category: "3D Printing",
    desc: "Componentă tehnică personalizată, modelată în CAD și produsă prin imprimare 3D FDM cu materiale tehnice.",
    image: "https://images.unsplash.com/photo-1503387873255-3a4a2345e650?auto=format&fit=crop&w=600&q=80",
    alt: "Prototip imprimat 3D la BlankSpace Studio — servicii de prototipare Brașov"
  },
  {
    title: "Proiect de Absolvire ICDL",
    category: "Educație",
    desc: "Portofoliu digital complet realizat de cursanți la finalul programului de competențe digitale ICDL România.",
    image: "https://images.unsplash.com/photo-1488190211105-8b0e65b80b4e?auto=format&fit=crop&w=600&q=80",
    alt: "Cursuri competențe digitale ICDL România la BlankSpace Brașov — proiecte absolvire"
  }
];
---

<section id="proiecte" class="relative py-20 md:py-28" style="background: #FFFFFF; border-top: 1px solid #D9D6D1;">
  <div class="mx-auto max-w-7xl px-6">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 md:mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-5">
          <span class="inline-block w-8 h-[2px]" style="background: #B8A22A;"></span>
          <span class="text-xs font-semibold tracking-[0.15em] uppercase" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">
            Portofoliu
          </span>
        </div>
        <h2 class="heading-2" style="color: #111111;">
          Proiecte selectate
        </h2>
        <p class="mt-4 text-base leading-relaxed body-text" style="color: #4B5563;">
          O parte din proiectele realizate la BlankSpace — în cursuri, în Studio și prin colaborări.
        </p>
      </div>
      <div>
        <a
          href="/proiecte"
          id="projects-all-link"
          class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors group"
          style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;"
          onmouseover="this.style.opacity='0.75';"
          onmouseout="this.style.opacity='1';"
        >
          Explorează tot portofoliul
          <svg class="size-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {projects.map((proj, idx) => (
        <article
          id={`project-card-${idx}`}
          class="group flex flex-col overflow-hidden rounded-2xl transition-all duration-300"
          style="background: #F4F4F4; border: 1px solid #D9D6D1;"
          onmouseover="this.style.boxShadow='0 16px 50px rgba(0,0,0,0.09)'; this.style.borderColor='rgba(184,162,42,0.3)'; this.style.transform='translateY(-3px)';"
          onmouseout="this.style.boxShadow='none'; this.style.borderColor='#D9D6D1'; this.style.transform='translateY(0)';"
        >
          {/* Image container */}
          <div class="aspect-[16/10] relative overflow-hidden" style="border-bottom: 1px solid #D9D6D1;">
            <img
              src={proj.image}
              alt={proj.alt}
              class="absolute inset-0 size-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(17,17,17,0.55) 0%, transparent 55%);"></div>

            {/* Category badge */}
            <div class="absolute top-4 left-4">
              <span class="text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full"
                    style="background: rgba(17,17,17,0.82); color: #B8A22A; border: 1px solid rgba(184,162,42,0.3); backdrop-filter: blur(8px); font-family: 'Plus Jakarta Sans', sans-serif;">
                {proj.category}
              </span>
            </div>
          </div>

          {/* Content */}
          <div class="p-6 flex flex-col flex-grow space-y-3">
            <h3 class="heading-4 font-semibold transition-colors duration-200 group-hover:text-[#B8A22A]" style="color: #111111;">
              {proj.title}
            </h3>
            <p class="text-sm leading-relaxed flex-grow body-text" style="color: #4B5563;">
              {proj.desc}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
---

<section
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
  style="background-color: #111111;"
  aria-label="Secțiunea principală BlankSpace">

  {/* Deep texture overlay — subtle grain */}
  <div class="hero-grain absolute inset-0 -z-10 opacity-[0.04]"></div>

  {/* Golden accent line top */}
  <div class="absolute top-0 left-0 right-0 h-[2px]" style="background: linear-gradient(90deg, transparent 0%, #B8A22A 40%, #C9B091 60%, transparent 100%);"></div>

  {/* Soft ambient glow — bottom left */}
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] -z-10 opacity-[0.06] blur-[100px] pointer-events-none rounded-full" style="background: #B8A22A;"></div>

  <div class="mx-auto max-w-7xl px-6 pt-12 pb-20 md:pt-16 md:pb-28 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center">

      {/* ── Left Column — Text Content ── */}
      <div class="space-y-8">

        {/* Live Badge */}
        <div class="animate-fade-in-up inline-flex items-center gap-2.5 rounded-full px-4 py-1.5"
             style="border: 1px solid rgba(184,162,42,0.25); background: rgba(184,162,42,0.07);">
          <span class="size-1.5 rounded-full animate-pulse" style="background:#B8A22A;"></span>
          <span class="text-xs font-semibold tracking-[0.12em] uppercase" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">
            Sesiunea de toamnă 2026 · Înscrierea este deschisă
          </span>
        </div>

        {/* Main Headline — H1 unic pe pagină */}
        <div class="animate-fade-in-up delay-100 space-y-3">
          <h1 class="hero-title" style="color: #F4F4F4;">
            Învață. Creează. <span style="color: #B8A22A;">Aplică.</span>
          </h1>
        </div>

        {/* Subtitle */}
        <p class="animate-fade-in-up delay-200 text-base md:text-lg leading-relaxed max-w-xl" style="color: #D9D6D1; font-family: 'Inter', sans-serif;">
          Cursuri practice, formare autorizată, certificări ICDL și servicii 3D — într-un studio în care ideile se transformă în competențe și proiecte reale.
        </p>

        {/* CTA Buttons */}
        <div class="animate-fade-in-up delay-400 flex flex-col sm:flex-row items-start gap-4">
          <a
            href="#activitati"
            id="hero-cta-primary"
            class="inline-flex h-12 items-center justify-center rounded-lg px-7 font-semibold text-base transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] group/btn btn-text"
            style="background: #B8A22A; color: #111111; box-shadow: 0 4px 24px rgba(184,162,42,0.28);"
          >
            Descoperă cursurile
            <svg class="ml-2 size-4 group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="#studio"
            id="hero-cta-secondary"
            class="inline-flex h-12 items-center justify-center rounded-lg px-7 font-medium text-base transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] btn-text"
            style="border: 1px solid rgba(217,214,209,0.25); color: #D9D6D1; background: rgba(255,255,255,0.04);"
          >
            Explorează Studio 3D
          </a>
        </div>

      </div>

      {/* ── Right Column — Cinematic Image ── */}
      <div class="animate-fade-in-up delay-200 relative">

        {/* Main image frame */}
        <div class="relative rounded-2xl overflow-hidden aspect-[4/5] lg:aspect-[3/4]"
             style="border: 1px solid rgba(184,162,42,0.12); box-shadow: 0 40px 100px rgba(0,0,0,0.65);">

          <picture>
            <source
              media="(min-width: 1024px)"
              srcset="/images/home/hero-blankspace-desktop-1600x900.webp"
              width="1600"
              height="900"
            />
            <source
              media="(min-width: 640px)"
              srcset="/images/home/hero-blankspace-tablet-1280x960.webp"
              width="1280"
              height="960"
            />
            <img
              src="/images/home/hero-blankspace-mobile-900x1200.webp"
              alt="Spațiul BlankSpace din Brașov pentru cursuri, formare și activități practice"
              class="absolute inset-0 size-full object-cover"
              loading="eager"
              fetchpriority="high"
              width="900"
              height="1200"
            />
          </picture>

          {/* Cinematic gradient overlay */}
          <div class="absolute inset-0" style="background: linear-gradient(170deg, rgba(17,17,17,0.08) 0%, rgba(17,17,17,0.0) 35%, rgba(17,17,17,0.55) 100%);"></div>

          {/* Top edge subtle vignette */}
          <div class="absolute top-0 left-0 right-0 h-20" style="background: linear-gradient(to bottom, rgba(17,17,17,0.25), transparent);"></div>


          {/* Corner accent — top left */}
          <div class="absolute top-0 left-0 w-12 h-[2px]" style="background: #B8A22A;"></div>
          <div class="absolute top-0 left-0 w-[2px] h-12" style="background: #B8A22A;"></div>
        </div>

        {/* Decorative glow orb */}
        <div class="absolute -top-6 -right-6 size-28 rounded-full -z-10 blur-3xl opacity-25"
             style="background: #B8A22A;"></div>

        {/* Secondary decorative element */}
        <div class="absolute -bottom-4 -left-4 size-16 rounded-full -z-10 blur-2xl opacity-15"
             style="background: #6D7E53;"></div>
      </div>

    </div>

    {/* Credibilitate — 3 iteme centrate sub hero grid */}
    <div class="animate-fade-in-up delay-500 flex flex-wrap items-start justify-center gap-x-8 gap-y-6 md:gap-x-14 pt-10 mt-4" style="border-top: 1px solid rgba(255,255,255,0.07);">

      {/* Item 1: ICDL */}
      <div class="text-center max-w-[140px] sm:max-w-none">
        <div class="text-base font-bold tracking-tight" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">ICDL</div>
        <div class="text-[11px] mt-1 leading-snug" style="color: #5A5A5A; font-family: 'Inter', sans-serif;">Centru de testare acreditat</div>
      </div>

      <div class="hidden sm:block h-10 w-px self-center" style="background: rgba(255,255,255,0.08);"></div>

      {/* Item 2: Formare autorizată */}
      <div class="text-center max-w-[180px] sm:max-w-none">
        <div class="text-base font-bold tracking-tight" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">Formare autorizată</div>
        <div class="text-[11px] mt-1 leading-snug" style="color: #5A5A5A; font-family: 'Inter', sans-serif;">Program autorizat în sistemul național de formare profesională a adulților</div>
      </div>

      <div class="hidden sm:block h-10 w-px self-center" style="background: rgba(255,255,255,0.08);"></div>

      {/* Item 3: Studio 3D */}
      <div class="text-center max-w-[160px] sm:max-w-none">
        <div class="text-base font-bold tracking-tight" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">Studio 3D</div>
        <div class="text-[11px] mt-1 leading-snug" style="color: #5A5A5A; font-family: 'Inter', sans-serif;">Scanare obiecte · Modelare · Imprimare</div>
      </div>

    </div>

  </div>

  {/* Bottom transition fade to light — reduced height for tighter spacing */}
  <div class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none"
       style="background: linear-gradient(to top, #F4F4F4 10%, transparent);"></div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }

  /* Subtle noise texture */
  .hero-grain {
    background-image:
      url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='60' height='60'%3E%3Cg fill='%23fff' fill-opacity='1'%3E%3Ccircle cx='1' cy='1' r='1'/%3E%3Ccircle cx='31' cy='31' r='1'/%3E%3C/g%3E%3C/svg%3E");
    background-repeat: repeat;
  }
</style>

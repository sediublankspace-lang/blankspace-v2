---
const interestOptions = [
  "Design Interior",
  "3D Printing",
  "ICDL",
  "Testare ICDL",
  "Studio 3D",
  "Colaborare",
  "Altceva"
];
---

<section id="contact" class="relative py-20 md:py-28" style="background: #F4F4F4; border-top: 1px solid #D9D6D1;" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">

      {/* ── Left — Intro ── */}
      <div class="lg:col-span-5 space-y-6">
        <div class="space-y-5">
          <div class="flex items-center gap-3">
            <span class="inline-block w-8 h-[2px]" style="background: #B8A22A;"></span>
            <span class="text-xs font-semibold tracking-[0.15em] uppercase" style="color: #B8A22A; font-family: 'Plus Jakarta Sans', sans-serif;">
              Hai să discutăm
            </span>
          </div>
          <h2 id="contact-heading" class="heading-2" style="color: #111111;">
            Contact
          </h2>
          <p class="text-base leading-relaxed body-text" style="color: #4B5563;">
            Cursuri, certificări sau un proiect 3D? Scrie-ne și îți răspundem cu informațiile de care ai nevoie.
          </p>
        </div>

        {/* Contact info */}
        <div class="space-y-4 pt-4" style="border-top: 1px solid #D9D6D1;">
          <div class="flex items-start gap-3">
            <svg class="size-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #B8A22A;" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <div>
              <div class="text-sm font-semibold" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">Adresă</div>
              <div class="text-sm body-text" style="color: #4B5563;">
                Str. 13 Decembrie nr. 127, bloc 4, parter, Studio BlankSpace, Qualis 2, Brașov, România
              </div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="size-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #B8A22A;" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <div>
              <div class="text-sm font-semibold" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">Email</div>
              <a href="mailto:sediu.blankspace@gmail.com" class="text-sm body-text transition-colors"
                 style="color: #4B5563;"
                 onmouseover="this.style.color='#B8A22A';"
                 onmouseout="this.style.color='#4B5563';">
                sediu.blankspace@gmail.com
              </a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="size-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #B8A22A;" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <div>
              <div class="text-sm font-semibold" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">Telefon</div>
              <a href="tel:+40772177156" class="text-sm body-text transition-colors"
                 style="color: #4B5563;"
                 onmouseover="this.style.color='#B8A22A';"
                 onmouseout="this.style.color='#4B5563';">
                0772 177 156
              </a>
            </div>
          </div>
        </div>

        {/* Google Maps embed — no tracking scripts, standard iframe */}
        <div class="mt-6 rounded-xl overflow-hidden" style="height: 200px; border: 1px solid #D9D6D1;">
          <iframe
            src="https://maps.google.com/maps?q=Str.+13+Decembrie+nr.+127+Brasov+Romania&output=embed"
            width="100%"
            height="100%"
            style="border: 0; display: block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Locație BlankSpace Brașov"
            aria-label="Hartă BlankSpace Brașov"
          ></iframe>
        </div>
      </div>

      {/* ── Right — Form ── */}
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="space-y-5 rounded-2xl p-8"
          style="background: #FFFFFF; border: 1px solid #D9D6D1; box-shadow: 0 8px 32px rgba(0,0,0,0.05);"
          aria-label="Formular de contact BlankSpace"
          novalidate
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {/* Nume */}
            <div class="space-y-1.5">
              <label for="contact-name" class="text-sm font-medium" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">
                Nume <span aria-hidden="true" style="color: #B8A22A;">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="Numele tău"
                required
                aria-required="true"
                autocomplete="name"
                class="contact-input w-full rounded-lg px-4 py-3 text-sm transition-all duration-200 outline-none"
                style="background: #F4F4F4; border: 1px solid #D9D6D1; color: #111111; font-family: 'Inter', sans-serif;"
              />
            </div>

            {/* Email */}
            <div class="space-y-1.5">
              <label for="contact-email" class="text-sm font-medium" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">
                Email <span aria-hidden="true" style="color: #B8A22A;">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="email@exemplu.ro"
                required
                aria-required="true"
                autocomplete="email"
                class="contact-input w-full rounded-lg px-4 py-3 text-sm transition-all duration-200 outline-none"
                style="background: #F4F4F4; border: 1px solid #D9D6D1; color: #111111; font-family: 'Inter', sans-serif;"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {/* Telefon */}
            <div class="space-y-1.5">
              <label for="contact-phone" class="text-sm font-medium" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">
                Telefon
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="+40 7XX XXX XXX"
                autocomplete="tel"
                class="contact-input w-full rounded-lg px-4 py-3 text-sm transition-all duration-200 outline-none"
                style="background: #F4F4F4; border: 1px solid #D9D6D1; color: #111111; font-family: 'Inter', sans-serif;"
              />
            </div>

            {/* Interes */}
            <div class="space-y-1.5">
              <label for="contact-interest" class="text-sm font-medium" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">
                Interes <span aria-hidden="true" style="color: #B8A22A;">*</span>
              </label>
              <select
                id="contact-interest"
                name="interest"
                required
                aria-required="true"
                class="contact-input w-full rounded-lg px-4 py-3 text-sm transition-all duration-200 outline-none appearance-none cursor-pointer"
                style="background: #F4F4F4; border: 1px solid #D9D6D1; color: #111111; font-family: 'Inter', sans-serif;"
              >
                <option value="" disabled selected>Selectează...</option>
                {interestOptions.map(opt => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>
          </div>

          {/* Mesaj */}
          <div class="space-y-1.5">
            <label for="contact-message" class="text-sm font-medium" style="color: #111111; font-family: 'Plus Jakarta Sans', sans-serif;">
              Mesaj <span aria-hidden="true" style="color: #B8A22A;">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={5}
              placeholder="Spune-ne cum te putem ajuta..."
              required
              class="contact-input w-full rounded-lg px-4 py-3 text-sm transition-all duration-200 outline-none resize-none"
              style="background: #F4F4F4; border: 1px solid #D9D6D1; color: #111111; font-family: 'Inter', sans-serif;"
            ></textarea>
          </div>

          {/* Submit */}
          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full min-h-[48px] h-12 rounded-lg font-semibold text-base transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] btn-text focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B8A22A] focus-visible:ring-offset-2"
            style="background: #B8A22A; color: #111111; box-shadow: 0 4px 20px rgba(184,162,42,0.28);"
            aria-label="Trimite formularul de contact"
          >
            Trimite mesajul
          </button>

          <p class="text-xs text-center body-text" style="color: #9CA3AF;">
            Îți răspundem în cel mai scurt timp posibil. Datele tale sunt confidențiale.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-input:focus {
    border-color: rgba(184, 162, 42, 0.55);
    box-shadow: 0 0 0 3px rgba(184, 162, 42, 0.1);
    background: #FFFFFF !important;
  }

  .contact-input::placeholder {
    color: #9CA3AF;
  }

  select.contact-input option {
    background: #FFFFFF;
    color: #111111;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina nu a fost găsită | BlankSpace Brașov"
  description="Pagina pe care o cauți nu există sau a fost mutată."
  robots="noindex, follow"
>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-6 bg-[#FFFFFF]">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="inline-flex items-center justify-center size-20 rounded-full bg-[#FAF9F5] border border-[#E8E5E0] text-[#B8A22A]">
        <span class="text-3xl font-bold font-heading">404</span>
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl md:text-3xl font-bold text-[#111111]" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Pagina nu a fost găsită
        </h1>
        <p class="text-base text-[#4B5563] body-text">
          Pagina pe care o cauți nu există sau a fost mutată.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/"
          class="inline-flex h-12 items-center justify-center rounded-lg px-7 font-semibold text-sm transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] btn-text"
          style="background: #B8A22A; color: #111111; box-shadow: 0 4px 20px rgba(184,162,42,0.28); font-family: 'Plus Jakarta Sans', sans-serif;"
        >
          Înapoi la BlankSpace
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

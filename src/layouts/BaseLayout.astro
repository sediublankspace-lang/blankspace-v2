---
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title = "BlankSpace Brașov | Design Interior, 3D și ICDL",
  description = "Cursuri practice în Brașov: Design Interior, Imprimare 3D, ICDL și pregătire Arhitectură. Centru de testare ICDL și servicii Studio 3D.",
  ogImage = "/images/home/hero-blankspace-desktop-1600x900.webp",
  robots = "index, follow",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://blankspace.ro');
const ogImageURL   = new URL(ogImage, Astro.site || 'https://blankspace.ro');

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "BlankSpace",
  "description": description,
  "url": "https://blankspace.ro",
  "telephone": "+40772177156",
  "email": "sediu.blankspace@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Str. 13 Decembrie nr. 127, bloc 4, parter",
    "addressLocality": "Brașov",
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.671607,
    "longitude": 25.609301
  },
  "knowsAbout": [
    "curs design interior",
    "imprimare 3D",
    "modelare 3D",
    "scanare 3D",
    "competențe digitale ICDL",
    "prototipare"
  ],
  "sameAs": [
    "https://www.facebook.com/sediu.BlankSpace",
    "https://www.instagram.com/blankspacebrasov/",
    "https://www.tiktok.com/@blankspace_brasov"
  ]
});
---

<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/brand/favicon-bs.png?v=3" />
    <link rel="apple-touch-icon" href="/images/brand/favicon-bs.png?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- BlankSpace launch visual design is approved and locked. Do not modify fonts, colors, shades, spacing or visual styling unless explicitly requested. -->
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta name="robots" content={robots} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="BlankSpace Brașov" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-brand/20 selection:text-brand">
    <!-- Skip to main content (keyboard navigation) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold focus:no-underline"
      style="background: #B8A22A; color: #111111;"
    >
      Sari la conținut
    </a>
    <div class="relative flex min-h-screen flex-col">
      <Header client:load />
      <main id="main-content" class="flex-grow pt-[66px] md:pt-[78px]">
        <slot />
      </main>
      <Footer />
    </div>
    <CookieConsent />
  </body>
</html>
